<Page
    x:Class="WidgetSampleCS.Widget1"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WidgetSampleCS"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
        <MenuBar VerticalAlignment="Top">
            <MenuBarItem Title="打开" ToolTipService.ToolTip="选择本地自定义的PNG准心文件，不要使用分辨率过大（基于您的屏幕）的准心文件，本程序不会缩放你的准心，以此保留原始信息">
                <MenuFlyoutItem Text="打开本地PNG准心" Click="SelectPNG_Click" ToolTipService.ToolTip="不要使用分辨率过大（基于您的屏幕）的准心文件"></MenuFlyoutItem>
            </MenuBarItem>
            <MenuBarItem Title="选择预设" ToolTipService.ToolTip="选择软件自带的，带标尺准心">
                <MenuFlyoutSubItem Text="战地一">
                    <MenuFlyoutItem Text="Gewehr 98"></MenuFlyoutItem>
                    <MenuFlyoutItem Text="Enfield 1917/M1903"></MenuFlyoutItem>
                    <MenuFlyoutItem Text="Mosin-Nagant/Russian 1895"></MenuFlyoutItem>
                    <MenuFlyoutItem Text="Type 38"></MenuFlyoutItem>
                    <MenuFlyoutItem Text="Ross MKⅢ/SMLE MKⅢ"></MenuFlyoutItem>
                    <MenuFlyoutItem Text="Lebel M1886勒贝尔"></MenuFlyoutItem>
                    <MenuFlyoutItem Text="Carcano M91卡尔卡诺"></MenuFlyoutItem>
                    <MenuFlyoutItem Text="Gewehr M95"></MenuFlyoutItem>
                    <MenuFlyoutItem Text="Russian 1895 Trench壕沟"></MenuFlyoutItem>
                    <MenuFlyoutItem Text="Martini-Henry马提尼"></MenuFlyoutItem>
                    <MenuFlyoutItem Text="Vetterli-Vitali M1870维塔利"></MenuFlyoutItem>
                </MenuFlyoutSubItem>
            </MenuBarItem>
        </MenuBar>
            <Button x:Name="centerScreenButton" Content="准心回中" Background="Transparent" Click="centerScreenButton_Click"></Button>
        </StackPanel>
        <StackPanel Grid.Column="0" Grid.Row="1" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock HorizontalAlignment="Center" FontSize="25" x:Name="alertToSelect">请选择自定义的PNG准心文件或选择准心预设</TextBlock>
        </StackPanel>
        <Image Grid.Column="0" Grid.Row="1" x:Name="CrosshairIMGplace" Stretch="None" VerticalAlignment="Center" HorizontalAlignment="Center">

        </Image>
    </Grid>
</Page>
